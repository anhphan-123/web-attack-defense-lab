    <field name="attack_type" type="pcre2">^XSS$</field>
    <field name="http_code" type="pcre2">^403$</field>
    <description>Purple Team: XSS attack blocked by ModSecurity WAF</description>
    <group>web_attack,xss,</group>
  </rule>
<rule id="100220" level="10">
  <decoded_as>json</decoded_as>
